#!/usr/bin/env python3

import os
import time
import subprocess
import syslog
import shlex

SERVER_WAIT_TIME = 2
CLIENT_WAIT_TIME = 1

DEBUG = False

class Shutdowner:

    def __init__(self):
        
        self.version_reference = ["adi", "desktop"]
        self.adiServer = "/usr/bin/natfree-adi"

        self.init_var()
        self.current_flavour = self.what_am_i()
        self.shutdown(self.current_flavour)

    def dprint(self, msg):
        
        msg = f"[lliurex-shutdowner] {msg}"
        if DEBUG:
            print(msg)
            syslog.syslog(msg)

    def init_var(self):
        
        self.shutdown_function = {
            "adi": self.adi_shutdown,
            "desktop": self.standalone_shutdown,
            "unknown": self.basic_shutdown
        }

    def what_am_i(self):
        
        if os.path.exists(self.adiServer):
            return "adi"
        return "desktop"

    def shutdown(self, flavour):

        func = self.shutdown_function.get(flavour, self.basic_shutdown)
        return func()

    def adi_shutdown(self):
        
        self.dprint("Server shutdown")
        self.dprint("Calling standalone_shutdown...")
        self.standalone_shutdown(wait_time=SERVER_WAIT_TIME)

    def standalone_shutdown(self,wait_time=CLIENT_WAIT_TIME):
        
        self.dprint("Standalone shutdown")
        waylandCommand = '"wayland;xcb"'
        
        try:
            result = subprocess.run(
                ["loginctl", "list-sessions", "--no-legend"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            sessions = result.stdout.strip().split("\n")
        except Exception as e:
            self.dprint(f"Error running loginctl: {e}")
            sessions = []
            
        for session_line in sessions:
            if not session_line.strip():
                continue
                
            parts = session_line.split()
            if len(parts) < 3:
                continue
                
            session_id = parts[0]
            user = parts[2]
            
            if user in ["root", "lightdm", "gdm", "sddm"]:
                continue
                
            session_type = subprocess.run(
                ["loginctl", "show-session", session_id, "-p", "Type", "--value"],
                stdout=subprocess.PIPE, text=True
                ).stdout.strip()
                
            display = subprocess.run(
                ["loginctl", "show-session", session_id, "-p", "Display", "--value"],
                stdout=subprocess.PIPE, text=True
            ).stdout.strip()
            
            if session_type == "wayland":
                command = f"su -c 'QT_QPA_PLATFORM={waylandCommand} /usr/sbin/shutdown-lliurex-dialog.py {wait_time}' {user} &"
            else:
                if not display:
                    display = ":0"
                command = f"su -c 'DISPLAY=%{display} /usr/sbin/shutdown-lliurex-dialog.py {wait_time}' {user} &" 
                    
            self.dprint("\t%s" % command)
            os.system(command)
        

        self.dprint("Calling basic_shutdown...")
        self.basic_shutdown(wait_time)
        
    #def standalone_shutdown
    
    def basic_shutdown(self, wait_time=CLIENT_WAIT_TIME):

        self.dprint("Basic shutdown")
        command = ["/sbin/shutdown", "-h", f"+{wait_time}"]
        self.dprint(f"\t{' '.join(command)}")
        subprocess.Popen(command)

if __name__ == "__main__":
    sd = Shutdowner()
