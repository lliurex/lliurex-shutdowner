#!/usr/bin/env python3

import os
import time
import subprocess
import syslog
import shlex

SERVER_WAIT_TIME = 2
CLIENT_WAIT_TIME = 1

DEBUG = False

class Shutdowner:

    def __init__(self):
        
        self.version_reference = ["adi", "desktop"]
        self.adiServer = "/usr/bin/natfree-adi"

        self.init_var()
        self.current_flavour = self.what_am_i()
        self.shutdown(self.current_flavour)

    #def __init

    def dprint(self, msg):
        
        msg = f"[lliurex-shutdowner] {msg}"
        if DEBUG:
            print(msg)
            syslog.syslog(msg)

    #def dprint

    def init_var(self):
        
        self.shutdown_function = {
            "adi": self.adi_shutdown,
            "desktop": self.standalone_shutdown,
            "unknown": self.basic_shutdown
        }

    #def init_var

    def what_am_i(self):
        
        if os.path.exists(self.adiServer):
            return "adi"
        return "desktop"

    #def what_am_i

    def shutdown(self, flavour):

        func = self.shutdown_function.get(flavour, self.basic_shutdown)
        return func()

    #def shutdown

    def adi_shutdown(self):
        
        self.dprint("Server shutdown")
        self.dprint("Calling standalone_shutdown...")
        self.standalone_shutdown(wait_time=SERVER_WAIT_TIME)

    #def adi_shutdown

    def standalone_shutdown(self, wait_time=CLIENT_WAIT_TIME):
        
        self.dprint("Standalone shutdown")
        waylandCommand = '"wayland;xcb"'

        p1 = subprocess.Popen(["who"], stdout=subprocess.PIPE)
        stdout, _ = p1.communicate()
        lines = stdout.decode("utf-8").strip().split("\n")

        for item in lines:
            if not item.strip():
                continue

            parts = item.split()
            if len(parts) < 2:
                continue

            user = parts[0]
            display = parts[-1]

            if "(" not in display or ")" not in display or ":" not in display:
                command = f"su -c 'QT_QPA_PLATFORM={waylandCommand} /usr/sbin/shutdown-lliurex-dialog.py {wait_time}' {shlex.quote(user)} &"
            else:
                display = display.lstrip("(").rstrip(")")
                command = f"su -c 'DISPLAY={display} /usr/sbin/shutdown-lliurex-dialog.py {wait_time}' {shlex.quote(user)} &"

            self.dprint(f"\t{command}")
            os.system(command)

        self.dprint("Calling basic_shutdown...")
        self.basic_shutdown(wait_time)

    #def standalone_shutdown

    def basic_shutdown(self, wait_time=CLIENT_WAIT_TIME):

        self.dprint("Basic shutdown")
        command = ["/sbin/shutdown", "-h", f"+{wait_time}"]
        self.dprint(f"\t{' '.join(command)}")
        subprocess.Popen(command)

    #def basic_shutdown

if __name__ == "__main__":
    sd = Shutdowner()
